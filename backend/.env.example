# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=generate-64-char-random-string-here
JWT_SECRET=generate-another-64-char-random-string-here
FLASK_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite — no setup required)
# DB_PATH=../data/atlon.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://atlon_user:password@localhost:5432/atlon_hrms

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@atlon.in
FROM_NAME=Atlon HRMS

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=atlon_wa_verify

# ── Billing ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# ── Super Admin ───────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@atlon.in
SUPER_ADMIN_PASSWORD=AtlonAdmin@123

# ── Domain ────────────────────────────────────────────────────────────────────
BASE_DOMAIN=atlon.in
FRONTEND_URL=http://localhost:5000

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
