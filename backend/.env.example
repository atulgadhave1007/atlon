# Copy to backend/.env and fill in. Never commit backend/.env.
# All values below are placeholders.

# ── Core ──────────────────────────────────────────────────────────────────────
# development | production | testing
FLASK_ENV=development
PORT=5000
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production refuses to start if these are unset, placeholders, or < 32 chars.
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. Required in production ("*" is rejected there).
# Development defaults to "*" if unset.
CORS_ORIGINS=http://localhost:5000

# ── Super admin bootstrap ─────────────────────────────────────────────────────
# Used only when no super admin exists yet (first start).
# Development: if SUPER_ADMIN_PASSWORD is empty, a random password is generated
#              and printed once to the console.
# Production:  if SUPER_ADMIN_PASSWORD is empty, no super admin is created.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────────
# Default (unset): SQLite at ../data/atlon.db
# DATABASE_URL=postgresql://atlon:CHANGE_ME@localhost:5432/atlon_hrms

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com
FROM_NAME=Atlon HRMS

# ── WhatsApp Cloud API (optional) ─────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Billing (optional; gateways are not integrated yet) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── File storage ──────────────────────────────────────────────────────────────
# local | s3 | minio
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=
AWS_REGION=ap-south-1

# ── Domain ────────────────────────────────────────────────────────────────────
# Tenants are resolved from <slug>.BASE_DOMAIN in production.
BASE_DOMAIN=example.com
FRONTEND_URL=http://localhost:5000

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# SENTRY_DSN=
